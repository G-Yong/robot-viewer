{
  "name": "robot-viewer",
  "displayName": "Robot Viewer",
  "description": "Import, visualize and interact with robot models (URDF/Xacro). Adjust joints, control the camera, tweak rendering, save scenes, and sync joint states over OPC UA / WebSocket.",
  "version": "0.2.0",
  "publisher": "G-Yong",
  "license": "MIT",
  "icon": "image/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/G-Yong/robot-viewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "urdf",
    "xacro",
    "robot",
    "ros",
    "visualization",
    "3d",
    "opcua"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "robotViewer.preview",
        "title": "Robot Viewer: Preview Robot Model",
        "icon": "$(open-preview)"
      },
      {
        "command": "robotViewer.openFile",
        "title": "Robot Viewer: Open Model File..."
      },
      {
        "command": "robotViewer.loadScene",
        "title": "Robot Viewer: Load Scene Configuration..."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "robotViewer.preview",
          "when": "resourceExtname == .urdf || resourceExtname == .xacro || resourceExtname == .URDF",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "robotViewer.preview",
          "when": "resourceExtname == .urdf || resourceExtname == .xacro",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Robot Viewer",
      "properties": {
        "robotViewer.packages": {
          "type": "object",
          "default": {},
          "description": "Maps ROS/ROS2 package names to local folders so 'package://<name>' paths in URDF/Xacro can be resolved. Values may use ${workspaceFolder} or be relative to the workspace.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "robotViewer.backgroundColor": {
          "type": "string",
          "default": "#263238",
          "description": "Background color of the 3D viewer (hex, e.g. #263238)."
        },
        "robotViewer.showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Show the ground grid by default."
        },
        "robotViewer.upAxis": {
          "type": "string",
          "enum": ["+Z", "+Y"],
          "default": "+Z",
          "description": "Up axis used when displaying the model (URDF convention is +Z)."
        },
        "robotViewer.reRenderOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-render the preview when the previewed file is saved."
        },
        "robotViewer.opcua.endpoint": {
          "type": "string",
          "default": "opc.tcp://localhost:4840",
          "description": "Default OPC UA endpoint URL used for joint state synchronization."
        },
        "robotViewer.opcua.nodeIdTemplate": {
          "type": "string",
          "default": "ns=2;s=Joints/{joint}",
          "description": "OPC UA NodeId template for each joint value. '{joint}' is replaced by the joint name."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "node-opcua-client": "^2.133.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/three": "^0.160.0",
    "@types/vscode": "^1.85.0",
    "@xmldom/xmldom": "^0.8.10",
    "esbuild": "^0.20.0",
    "three": "^0.160.0",
    "typescript": "^5.3.0",
    "urdf-loader": "^0.12.1",
    "xacro-parser": "^0.3.9"
  }
}
