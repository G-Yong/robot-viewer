<?xml version="1.0"?>
<!-- A minimal 3-DOF arm using only primitive geometry (no external meshes),
     handy for verifying the Robot Viewer without any package resources. -->
<robot name="simple_arm">
  <material name="base_color">
    <color rgba="0.30 0.35 0.40 1.0"/>
  </material>
  <material name="link_color">
    <color rgba="0.20 0.60 0.86 1.0"/>
  </material>
  <material name="tip_color">
    <color rgba="0.95 0.55 0.20 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.10"/>
      </geometry>
      <material name="base_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.10"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.40"/>
      </geometry>
      <material name="link_color"/>
    </visual>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
      <material name="link_color"/>
    </visual>
  </link>

  <link name="tool">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="tip_color"/>
    </visual>
  </link>

  <joint name="shoulder_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <joint name="elbow_pitch" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="wrist_pitch" type="revolute">
    <parent link="link2"/>
    <child link="tool"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
</robot>
